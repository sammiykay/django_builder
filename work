def calculate_total_time(time_list):
    total_time = timedelta()

    for time_str in time_list:
        time_components = [int(x) for x in time_str.split(':')]
        total_time += timedelta(hours=time_components[-3] if len(time_components) == 3 else 0,
                                minutes=time_components[-2],
                                seconds=time_components[-1] if len(time_components) == 3 else time_components[-1])

    return total_time


