def calculate_total_time(time_strings):
    total_seconds = 0

    for time_str in time_strings:
        # Use try-except block to handle different time formats
        try:
            # Parse the time string and convert to timedelta
            time_parts = [int(part) for part in time_str.split(":")]
            time_delta = timedelta(hours=time_parts[-3], minutes=time_parts[-2], seconds=time_parts[-1])

            # Convert timedelta to total seconds and add to the total
            total_seconds += time_delta.total_seconds()
        except ValueError:
            print(f"Invalid time format: {time_str}")

    # Convert the total seconds to hours, minutes, and seconds
    total_time = str(timedelta(seconds=total_seconds))

    return total_time


